DATABASE_URL=postgresql+psycopg2://loonie:loonie@db:5432/loonie

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Random string you invent — pass it as secret_token when calling Telegram's
# setWebhook, and it must match the header Telegram sends back on every call.
TELEGRAM_WEBHOOK_SECRET=

# Random string you invent — required as the X-Loonie-Setup-Secret header on
# /plaid/link-token and /plaid/exchange-token so a stranger who finds your
# ngrok URL can't start a Link flow or exchange tokens on your behalf.
SETUP_SECRET=
