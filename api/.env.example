DATABASE_URL=postgresql+psycopg2://qolar:qolar@db:5432/qolar

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Random string you invent — pass it as secret_token when calling Telegram's
# setWebhook, and it must match the header Telegram sends back on every call.
TELEGRAM_WEBHOOK_SECRET=

# Random string you invent — required as the X-Qolar-Setup-Secret header on
# /plaid/link-token and /plaid/exchange-token so a stranger who finds your
# ngrok URL can't start a Link flow or exchange tokens on your behalf.
SETUP_SECRET=

# Encrypts Plaid access tokens at rest. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Public URL this service is reachable at right now (ngrok/cloudflared tunnel
# during local dev). Changes every time you restart the tunnel -- update this
# and re-create the link token whenever that happens.
WEBHOOK_BASE_URL=
